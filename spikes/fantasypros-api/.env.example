# FantasyPros API spike config — copy this file to ".env" and fill in the blanks.
# The real ".env" is git-ignored and never committed. See README.md for how to
# get a free API key. You only need FP_API_KEY to start.

# Your FantasyPros API key. Request a FREE key (self-serve, no cost) at:
#   https://secure.fantasypros.com/api-keys/request/
# It is sent as the "x-api-key" header. Treat it like a password.
FP_API_KEY=

# Usually leave these as-is.
FP_API_HOST=api.fantasypros.com
FP_BASE_PATH=/public/v2/json
FP_SPORT=nfl

# The season year to pull. 2026 = the current NFL season.
FP_SEASON=2026
