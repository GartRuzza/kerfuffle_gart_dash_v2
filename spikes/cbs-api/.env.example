# CBS API spike config — copy this file to ".env" and fill in the blanks.
# The real ".env" is git-ignored and never committed. See README.md for how to
# find these values in your browser. You do NOT need all of them — start with a
# token and/or a cookie.

# The access token from your logged-in CBS session (if you can find one).
CBS_ACCESS_TOKEN=

# The full Cookie header copied from a logged-in KERFUFFLE page (often the
# reliable path). One long line of "name=value; name2=value2; ...".
CBS_COOKIE=

# Your league's subdomain host. Find it in the URL when you're on the league
# site, e.g. https://kerfuffle.cbssports.com/  ->  kerfuffle.cbssports.com
CBS_LEAGUE_HOST=

# Usually leave these as-is.
CBS_API_HOST=fantasy-api.cbssports.com
CBS_SPORT=football

# Optional: a past season to test historical depth, e.g. 2024. Leave blank for current.
CBS_SEASON=
